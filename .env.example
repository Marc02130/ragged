# Copy to .env. Compose interpolates POSTGRES_* into DATABASE_URL.
# Do not set DATABASE_URL, VITE_*, or NEXT_PUBLIC_* here.
#
# Production behind TLS: COOKIE_SECURE=true and PUBLIC_ORIGINS=https://your.host
# Backups (operator): nightly pg_dump + tar of the uploads volume (see README).
# Host webpack overlay: docker compose -f docker-compose.yml -f docker-compose.dev.yml up
#   (API on localhost:8001; Compose nginx SPA stays on :8080).

POSTGRES_USER=ragged
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragged

JWT_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=sk-replace-me
# Optional operator-wide fallbacks. Users can also paste their own keys in the UI.
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Embeddings are local (all-MiniLM-L6-v2, 384-d). stub = tests only.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COOKIE_SECURE=false

# CSRF Origin allowlist (comma-separated). Docker nginx :8080 and webpack-dev-server :3000.
# Production: replace with the TLS origin, e.g. https://ragged.example
PUBLIC_ORIGINS=http://localhost:8080,http://localhost:3000

# Empty = CORS middleware off (both documented loops). Do not set *.
CORS_ORIGINS=
